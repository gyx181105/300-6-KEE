@prefix : <https://kee.dev/packs/demo-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<> a owl:Ontology ;
  rdfs:label "Demo Ontology" ;
  rdfs:comment "Non-medical A7 fixture: a tiny library catalog." .

:Book a owl:Class ;
  rdfs:label "Book" ;
  rdfs:comment "A published work that can be catalogued in a library." .

:Library a owl:Class ;
  rdfs:label "Library" ;
  rdfs:comment "An institution that holds and lends books." .

:holds a owl:ObjectProperty ;
  rdfs:label "holds" ;
  rdfs:comment "A library holds a book in its collection." ;
  rdfs:domain :Library ;
  rdfs:range :Book .
