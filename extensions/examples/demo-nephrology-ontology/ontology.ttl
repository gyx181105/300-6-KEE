@prefix : <https://kee.dev/packs/demo-nephrology-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<> a owl:Ontology ;
  rdfs:label "Demo Nephrology Ontology" ;
  rdfs:comment "Synthetic B3 fixture. No ICD/SNOMED codes; not for clinical use." .

:LabObservation a owl:Class ;
  rdfs:label "Lab Observation" ;
  rdfs:comment "A laboratory observation recorded for a patient encounter." .

:CreatinineResult a owl:Class ;
  rdfs:subClassOf :LabObservation ;
  rdfs:label "Creatinine Result" ;
  rdfs:comment "Serum creatinine laboratory result (demo class only)." .

:EgfrResult a owl:Class ;
  rdfs:subClassOf :LabObservation ;
  rdfs:label "eGFR Result" ;
  rdfs:comment "Estimated glomerular filtration rate result (demo class only)." .

:measuredAs a owl:ObjectProperty ;
  rdfs:label "measured as" ;
  rdfs:comment "Links a lab observation to its reported value shape (demo)." ;
  rdfs:domain :LabObservation ;
  rdfs:range :LabObservation .

:derivedFrom a owl:ObjectProperty ;
  rdfs:label "derived from" ;
  rdfs:comment "eGFR may be derived from creatinine (demo relation)." ;
  rdfs:domain :EgfrResult ;
  rdfs:range :CreatinineResult .
