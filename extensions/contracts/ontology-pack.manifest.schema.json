{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kee.dev/schemas/ontology-pack.manifest.schema.json",
  "title": "OntologyPackManifest",
  "description": "A7 L1 Ontology Pack manifest. Content-only; no executable payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "kee.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "OntologyPack"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "name", "summary", "publisher"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$",
          "description": "Stable pack id used in install APIs and import ledger annotations."
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][A-Za-z0-9.-]+)?$",
          "description": "Semver-like immutable release version."
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 512 },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ontologyFile", "format"],
      "properties": {
        "ontologyFile": {
          "type": "string",
          "description": "Relative path inside the pack directory (e.g. ontology.ttl)."
        },
        "format": {
          "type": "string",
          "enum": ["turtle", "rdfxml"]
        },
        "license": { "type": "string", "maxLength": 128 },
        "classes": {
          "type": "integer",
          "minimum": 0,
          "description": "Display count only; runtime plan is authoritative."
        },
        "properties": {
          "type": "integer",
          "minimum": 0,
          "description": "Display count only; runtime plan is authoritative."
        }
      }
    }
  }
}
